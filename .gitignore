# Local environment and caches - none of this belongs in version control.
.venv/
.venv-*/
.uvcache/
.uvpython/
.hf/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
# `uv build` / `python -m build` output. None of it is source.
dist/
build/
.build-check/
# Development scratch: bench scripts, render logs, reference screenshots.
.cache/
# A throwaway LINTRANSLATOR_HOME, used to exercise a first run by hand.
.dl-demo/

# Runtime state. The app keeps this in the XDG directories now (lintranslator/paths.py);
# these paths are what an older checkout left behind.
data/cache.json
data/tessdata/
data/*.png
config.json

# Weights converted in-tree. GitHub rejects files over 100 MB, and none of this is
# source.
data/ct2/
data/*.bin
data/*.safetensors

# Probe leftovers.
#
# Reference screenshots are the one category here that is not merely untidy:
# `probe/shot.webp` was a full frame of a commercial game, and it rode into the
# repository on the strength of `probe/*.png` not covering `.webp`. Screenshots
# of a game you did not write are not ours to redistribute, so every image
# extension the probes use is listed, and none of them are tracked.
probe/dl/
probe/wheels*/
probe/*.png
probe/*.webp
probe/*.jpg
probe/*.jpeg
probe/tessdata/
probe/*.out

# Tool scratch that lands in the working directory, not part of the project.
:memory:.ses
