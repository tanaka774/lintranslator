#!/bin/sh
# Launcher for the desktop entry.
#
# Launched from the application menu, KDE starts this under an `app-*.scope`, which
# is what gives tl-kun an *application id*. That matters for exactly one feature:
# `org.freedesktop.portal.GlobalShortcuts` refuses callers without one
# ("An app id is required"), so the compositor-granted global hotkey only works
# when the app was started this way (or as a systemd user unit / from a Flatpak).
#
# Everything else - including the Re-read button, Ctrl+R/F5 in the panel, and
# `tlkun reread` over the control socket - works from any launch.
set -eu
exec /home/chiba/workspace/tl-kun/.venv-gi/bin/tlkun gui "$@"
